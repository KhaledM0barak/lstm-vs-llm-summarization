# Secrets — never commit
.env

# Virtualenv
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Downloaded/processed dataset: regenerate with `python -m src.data.prepare`.
# CNN/DailyMail is Apache-2.0 but ~400 MB processed; not redistributed here.
# The leading slash anchors this to the repository root -- an unanchored `data/`
# also matches `src/data/`, which silently excluded the entire data-pipeline
# package from the repository.
/data/
!/data/.gitkeep

# Model checkpoints (~60 MB each). Training logs and metrics ARE committed.
runs/**/*.pt
*.log

# HuggingFace cache
.cache/

# OS
.DS_Store
reports/report.html

# Intermediate scoring runs superseded by results/ -- regenerate with scripts/finish.sh
results/partial/
results/lstm_only/
